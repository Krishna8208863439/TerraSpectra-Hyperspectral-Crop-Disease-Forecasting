# Environment configuration for TerraSpectra

# FastAPI Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production

# Database
DATABASE_URL=sqlite:///./app/database/terraspectra.db

# Hyperspectral Preprocessing
DEFAULT_WAVELENGTH_MIN=400.0
DEFAULT_WAVELENGTH_MAX=1000.0
MIN_SPECTRAL_BANDS=10
SAVGOL_WINDOW_LENGTH=7
SAVGOL_POLYORDER=2

# Environmental Intelligence API
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
DEFAULT_LATITUDE=16.7050
DEFAULT_LONGITUDE=74.2433

